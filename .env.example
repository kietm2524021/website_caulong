SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://your-domain.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_AGE=43200
SESSION_IDLE_TIMEOUT=3600
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_SECONDS=900

DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL_REQUIRE=True

# Use either CLOUDINARY_URL or the three separate Cloudinary variables below.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

CREATE_SUPERUSER=True
DJANGO_SUPERUSER_USERNAME=your-admin-phone
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password
DJANGO_SUPERUSER_EMAIL=admin@your-domain.com

# Optional AI auto-reply for the support page.
# Set these in Render Environment, never commit a real API key.
AI_SUPPORT_ENABLED=True
AI_SUPPORT_MODEL=gpt-5.5
AI_SUPPORT_API_URL=https://api.openai.com/v1/responses
AI_SUPPORT_TIMEOUT=12
AI_SUPPORT_API_KEY=
OPENAI_API_KEY=sk-your-api-key
